<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator
                android:duration="90"
                android:propertyName="scaleX"
                android:valueTo="0.985"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="90"
                android:propertyName="scaleY"
                android:valueTo="0.985"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="90"
                android:propertyName="translationZ"
                android:valueTo="1dp"
                android:valueType="floatType" />
        </set>
    </item>
    <item android:state_hovered="true">
        <set>
            <objectAnimator
                android:duration="140"
                android:propertyName="scaleX"
                android:valueTo="1.012"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="140"
                android:propertyName="scaleY"
                android:valueTo="1.012"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="140"
                android:propertyName="translationZ"
                android:valueTo="6dp"
                android:valueType="floatType" />
        </set>
    </item>
    <item android:state_focused="true">
        <set>
            <objectAnimator
                android:duration="140"
                android:propertyName="scaleX"
                android:valueTo="1.012"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="140"
                android:propertyName="scaleY"
                android:valueTo="1.012"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="140"
                android:propertyName="translationZ"
                android:valueTo="6dp"
                android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator
                android:duration="160"
                android:propertyName="scaleX"
                android:valueTo="1.0"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="160"
                android:propertyName="scaleY"
                android:valueTo="1.0"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="160"
                android:propertyName="translationZ"
                android:valueTo="0dp"
                android:valueType="floatType" />
        </set>
    </item>
</selector>
