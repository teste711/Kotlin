<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_margin="12dp"
    app:cardBackgroundColor="@color/card_surface"
    app:cardCornerRadius="22dp"
    app:cardElevation="14dp"
    app:cardUseCompatPadding="true"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 1. Banner Superior (idêntico ao modal de ação) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_home_banner"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/tvModalTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Gerenciar Categoria"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Corpo do Modal -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Toggle Modo da Categoria: Predefinida vs Personalizada -->
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleModoCategoria"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:checkedButton="@+id/btnModoCatPredefinida"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnModoCatPredefinida"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="36dp"
                        android:text="Predefinida"
                        android:textAllCaps="false"
                        android:textSize="11sp"
                        app:cornerRadius="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnModoCatPersonalizada"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="36dp"
                        android:text="Personalizada"
                        android:textAllCaps="false"
                        android:textSize="11sp"
                        app:cornerRadius="8dp" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <!-- Container Categoria Predefinida -->
                <LinearLayout
                    android:id="@+id/containerCatPredefinida"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Selecione a Categoria Predefinida"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spnCategoriaPredefinida"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_spinner_slot"
                        android:paddingHorizontal="10dp" />
                </LinearLayout>

                <!-- Container Categoria Personalizada -->
                <LinearLayout
                    android:id="@+id/containerCatPersonalizada"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Título da categoria"
                        app:boxBackgroundColor="@color/card_surface"
                        app:boxCornerRadiusBottomEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp"
                        app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusTopStart="8dp"
                        app:boxStrokeColor="@color/card_stroke">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCategoryName"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:inputType="textCapSentences"
                            android:paddingTop="0dp"
                            android:paddingBottom="0dp"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- 2. Seção da Imagem da Categoria (mesmo estilo do modal de ação) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Imagem da Categoria"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:cardBackgroundColor="@color/card_surface_secondary"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/card_stroke_light"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <ImageView
                            android:id="@+id/ivCategoryPreview"
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:contentDescription="Preview da Imagem"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_default_button" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSelectCategoryPhoto"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="4dp"
                                android:layout_weight="1"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:minHeight="36dp"
                                android:padding="0dp"
                                android:soundEffectsEnabled="true"
                                android:text="Galeria"
                                android:textAllCaps="false"
                                android:textColor="@color/text_primary"
                                android:textSize="11sp"
                                app:cornerRadius="6dp"
                                app:icon="@android:drawable/ic_menu_gallery"
                                app:iconGravity="textStart"
                                app:iconSize="14dp"
                                app:iconTint="@color/brand_primary"
                                tools:ignore="TouchTargetSizeCheck" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnTakeCategoryCamera"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:layout_weight="1"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:minHeight="36dp"
                                android:padding="0dp"
                                android:soundEffectsEnabled="true"
                                android:text="Câmera"
                                android:textAllCaps="false"
                                android:textColor="@color/text_primary"
                                android:textSize="11sp"
                                app:cornerRadius="6dp"
                                app:icon="@android:drawable/ic_menu_camera"
                                app:iconGravity="textStart"
                                app:iconSize="14dp"
                                app:iconTint="@color/brand_primary"
                                tools:ignore="TouchTargetSizeCheck" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSelectCategoryDrawing"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="4dp"
                                android:layout_weight="1"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:minHeight="36dp"
                                android:padding="0dp"
                                android:soundEffectsEnabled="true"
                                android:text="Desenhos"
                                android:textAllCaps="false"
                                android:textColor="@color/text_primary"
                                android:textSize="11sp"
                                app:cornerRadius="6dp"
                                app:icon="@android:drawable/ic_menu_today"
                                app:iconGravity="textStart"
                                app:iconSize="14dp"
                                app:iconTint="@color/brand_primary"
                                tools:ignore="TouchTargetSizeCheck" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnDefaultCategoryImg"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:layout_weight="1"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:minHeight="36dp"
                                android:padding="0dp"
                                android:soundEffectsEnabled="true"
                                android:text="Padrão"
                                android:textAllCaps="false"
                                android:textColor="@color/text_primary"
                                android:textSize="11sp"
                                app:cornerRadius="6dp"
                                app:icon="@android:drawable/ic_menu_close_clear_cancel"
                                app:iconGravity="textStart"
                                app:iconSize="14dp"
                                app:iconTint="@color/text_muted"
                                tools:ignore="TouchTargetSizeCheck" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 3. Seleção de Voz Padrão: Feminina vs Masculina -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Voz do Áudio Padrão"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleGeneroAudioCategoria"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="6dp"
                    app:checkedButton="@+id/btnCatAudioFeminino"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCatAudioFeminino"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="36dp"
                        android:text="Áudio Feminino"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        app:cornerRadius="6dp"
                        app:icon="@android:drawable/ic_btn_speak_now"
                        app:iconGravity="textStart"
                        app:iconSize="14dp"
                        app:iconTint="@color/brand_primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCatAudioMasculino"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="36dp"
                        android:text="Áudio Masculino"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        app:cornerRadius="6dp"
                        app:icon="@android:drawable/ic_btn_speak_now"
                        app:iconGravity="textStart"
                        app:iconSize="14dp"
                        app:iconTint="@color/brand_primary" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <!-- Escolher Áudio do Dispositivo -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelectCategoryAudio"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="36dp"
                    android:soundEffectsEnabled="true"
                    android:text="Escolher Áudio do Dispositivo"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    app:cornerRadius="6dp"
                    app:icon="@android:drawable/ic_menu_search"
                    app:iconGravity="textStart"
                    app:iconSize="14dp"
                    app:iconTint="@color/brand_primary"
                    tools:ignore="TouchTargetSizeCheck" />

                <!-- Gravação de Áudio In-App -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRecordCategoryAudio"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="36dp"
                        android:padding="0dp"
                        android:soundEffectsEnabled="true"
                        android:text="Gravar Voz"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="11sp"
                        app:backgroundTint="@color/danger_red"
                        app:cornerRadius="6dp"
                        app:icon="@android:drawable/ic_btn_speak_now"
                        app:iconGravity="textStart"
                        app:iconSize="14dp"
                        app:iconTint="@android:color/white"
                        tools:ignore="TouchTargetSizeCheck" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStopCategoryAudio"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="36dp"
                        android:padding="0dp"
                        android:soundEffectsEnabled="true"
                        android:text="Parar"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="11sp"
                        android:visibility="gone"
                        app:backgroundTint="#B91C1C"
                        app:cornerRadius="6dp"
                        app:icon="@android:drawable/ic_media_pause"
                        app:iconGravity="textStart"
                        app:iconSize="14dp"
                        app:iconTint="@android:color/white"
                        tools:ignore="TouchTargetSizeCheck" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPreviewCategoryAudio"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="36dp"
                        android:padding="0dp"
                        android:soundEffectsEnabled="true"
                        android:text="Prévia"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:visibility="gone"
                        app:cornerRadius="6dp"
                        app:icon="@android:drawable/ic_media_play"
                        app:iconGravity="textStart"
                        app:iconSize="14dp"
                        app:iconTint="@color/brand_primary"
                        tools:ignore="TouchTargetSizeCheck" />
                </LinearLayout>

                <!-- Barra de Progresso de Upload -->
                <ProgressBar
                    android:id="@+id/progressCategoryModal"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <!-- 4. Botões Finais (Cancelar / Salvar) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCancelCategory"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:elevation="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="38dp"
                        android:soundEffectsEnabled="true"
                        android:stateListAnimator="@animator/outlined_button_hover_press_animator"
                        android:text="Cancelar"
                        android:textAllCaps="false"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        app:cornerRadius="10dp"
                        tools:ignore="TouchTargetSizeCheck" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveCategory"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="38dp"
                        android:soundEffectsEnabled="true"
                        android:stateListAnimator="@animator/button_hover_press_animator"
                        android:text="Salvar Categoria"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/brand_primary"
                        app:cornerRadius="10dp"
                        tools:ignore="TouchTargetSizeCheck" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
